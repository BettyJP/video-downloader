# CentOS / RHEL 8 compatible builder (AlmaLinux 8, glibc 2.28) for vdl-centos-x86_64.tar.gz
FROM almalinux:8

RUN dnf install -y epel-release && \
    dnf install -y \
      python3.12 \
      python3.12-pip \
      python3.12-devel \
      gcc \
      curl \
      tar \
      xz \
      binutils \
      findutils && \
    dnf clean all

WORKDIR /workspace

# Download static Linux FFmpeg binary
RUN mkdir -p /tmp/ffmpeg && \
    curl -L "https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-linux64-gpl.tar.xz" -o /tmp/ffmpeg/ffmpeg.tar.xz && \
    tar -xf /tmp/ffmpeg/ffmpeg.tar.xz -C /tmp/ffmpeg && \
    cp /tmp/ffmpeg/ffmpeg-master-latest-linux64-gpl/bin/ffmpeg /usr/local/bin/ffmpeg && \
    chmod +x /usr/local/bin/ffmpeg && \
    rm -rf /tmp/ffmpeg

COPY pyproject.toml requirements.txt README.md build.py ./
COPY src ./src

RUN python3.12 -m pip install --no-cache-dir --upgrade pip && \
    python3.12 -m pip install --no-cache-dir -r requirements.txt && \
    python3.12 -m pip install --no-cache-dir -e . && \
    mkdir -p bin && cp /usr/local/bin/ffmpeg bin/ffmpeg && \
    python3.12 build.py --clean --archive --target-name vdl-centos-x86_64

