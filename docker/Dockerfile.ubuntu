# Ubuntu 22.04 builder for Python runtime bundled package (vdl-ubuntu-x86_64.tar.gz)
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
     software-properties-common \
     curl \
     xz-utils \
     binutils \
     build-essential \
    && add-apt-repository ppa:deadsnakes/ppa -y \
    && apt-get update && apt-get install -y \
     python3.12 \
     python3.12-dev \
     python3.12-venv \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python3.12 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Download static Linux FFmpeg binary
RUN mkdir -p /tmp/ffmpeg && \
    curl -L "https://github.com/BtbN/FFmpeg-Builds/releases/download/latest/ffmpeg-master-latest-linux64-gpl.tar.xz" -o /tmp/ffmpeg/ffmpeg.tar.xz && \
    tar -xf /tmp/ffmpeg/ffmpeg.tar.xz -C /tmp/ffmpeg && \
    cp /tmp/ffmpeg/ffmpeg-master-latest-linux64-gpl/bin/ffmpeg /usr/local/bin/ffmpeg && \
    chmod +x /usr/local/bin/ffmpeg && \
    rm -rf /tmp/ffmpeg

COPY pyproject.toml requirements.txt README.md build.py ./
COPY src ./src

RUN python3.12 -m pip install --no-cache-dir -r requirements.txt && \
    python3.12 -m pip install --no-cache-dir -e . && \
    mkdir -p bin && cp /usr/local/bin/ffmpeg bin/ffmpeg && \
    python3.12 build.py --clean --archive --target-name vdl-ubuntu-x86_64

